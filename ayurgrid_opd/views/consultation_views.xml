<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_ag_opd_consultation_tree" model="ir.ui.view">
        <field name="name">ag.opd.consultation.tree</field>
        <field name="model">ag.opd.consultation</field>
        <field name="arch" type="xml">
            <list string="Consultations">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="consultation_date"/>
                <field name="consultation_type"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ag_opd_consultation_form" model="ir.ui.view">
        <field name="name">ag.opd.consultation.form</field>
        <field name="model">ag.opd.consultation</field>
        <field name="arch" type="xml">
            <form string="Consultation">
                <header>
                    <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark as Done" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="appointment_id"/>
                        </group>
                        <group>
                            <field name="consultation_date"/>
                            <field name="consultation_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Vitals">
                            <group>
                                <group>
                                    <field name="bp"/>
                                    <field name="pulse"/>
                                    <field name="respiratory_rate"/>
                                    <field name="spo2"/>
                                </group>
                                <group>
                                    <field name="temperature"/>
                                    <field name="weight"/>
                                    <field name="height"/>
                                    <field name="bmi" readonly="1"/>
                                    <field name="waist_circumference"/>
                                </group>
                            </group>
                        </page>
                        <page string="Ashtavidha Pariksha">
                            <group>
                                <group>
                                    <field name="nadi"/>
                                    <field name="mala"/>
                                    <field name="mutra"/>
                                    <field name="jihwa"/>
                                </group>
                                <group>
                                    <field name="shabda"/>
                                    <field name="sparsha"/>
                                    <field name="drika"/>
                                    <field name="akruti"/>
                                </group>
                            </group>
                        </page>
                        <page string="Dashavidha Pariksha">
                            <group>
                                <group>
                                    <field name="prakriti"/>
                                    <field name="vikriti"/>
                                    <field name="sara"/>
                                    <field name="samhanana"/>
                                    <field name="pramana"/>
                                </group>
                                <group>
                                    <field name="satmya"/>
                                    <field name="satva"/>
                                    <field name="ahara_shakti"/>
                                    <field name="vyayama_shakti"/>
                                    <field name="vaya"/>
                                </group>
                            </group>
                        </page>
                        <page string="Chief Complaints">
                            <field name="complaint_ids">
                                <list editable="bottom">
                                    <field name="sanskrit_term"/>
                                    <field name="english_term"/>
                                    <field name="duration"/>
                                    <field name="severity"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Diagnosis">
                            <group>
                                <field name="samprapti"/>
                                <field name="ayurveda_diagnosis"/>
                                <field name="modern_diagnosis"/>
                            </group>
                        </page>
                        <page string="Prescription">
                            <field name="prescription_ids">
                                <list editable="bottom">
                                    <field name="medicine_id"/>
                                    <field name="dose"/>
                                    <field name="frequency"/>
                                    <field name="anupana"/>
                                    <field name="duration"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Procedures">
                            <field name="procedure_advice_ids">
                                <list editable="bottom">
                                    <field name="procedure_name"/>
                                    <field name="material"/>
                                    <field name="total_sessions"/>
                                    <field name="frequency"/>
                                    <field name="start_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>
</odoo>
