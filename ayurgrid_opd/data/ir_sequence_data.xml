<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for OPD Appointment -->
        <record id="seq_ag_opd_appointment" model="ir.sequence">
            <field name="name">OPD Appointment Sequence</field>
            <field name="code">ag.opd.appointment</field>
            <field name="prefix">APP/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for OPD Consultation -->
        <record id="seq_ag_opd_consultation" model="ir.sequence">
            <field name="name">OPD Consultation Sequence</field>
            <field name="code">ag.opd.consultation</field>
            <field name="prefix">CON/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for OPD Therapy Prescription -->
        <record id="seq_ag_opd_therapy_prescription" model="ir.sequence">
            <field name="name">OPD Therapy Prescription Sequence</field>
            <field name="code">ag.opd.therapy.prescription</field>
            <field name="prefix">THR/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
