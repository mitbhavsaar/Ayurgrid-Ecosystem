<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- list View -->
    <record id="view_ag_organization_list" model="ir.ui.view">
        <field name="name">ag.organization.list</field>
        <field name="model">ag.organization</field>
        <field name="arch" type="xml">
            <list string="Organizations">
                <field name="name"/>
                <field name="legal_name"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="city"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ag_organization_form" model="ir.ui.view">
        <field name="name">ag.organization.form</field>
        <field name="model">ag.organization</field>
        <field name="arch" type="xml">
            <form string="Organization">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="legal_name"/>
                            <field name="llp_cin"/>
                            <field name="gstin"/>
                            <field name="pan"/>
                        </group>
                        <group>
                            <field name="email" widget="email"/>
                            <field name="mobile" widget="phone"/>
                            <field name="website" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address Info">
                            <group>
                                <group>
                                    <field name="address"/>
                                    <field name="city"/>
                                    <field name="district"/>
                                </group>
                                <group>
                                    <field name="state_id"/>
                                    <field name="country_id"/>
                                    <field name="pincode"/>
                                </group>
                            </group>
                        </page>
                        <page string="Settings">
                            <group>
                                <field name="timezone"/>
                                <field name="currency_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ag_organization" model="ir.actions.act_window">
        <field name="name">Organizations</field>
        <field name="res_model">ag.organization</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Organization
            </p>
        </field>
    </record>
</odoo>
