<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ag_room_list" model="ir.ui.view">
        <field name="name">ag.room.list</field>
        <field name="model">ag.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="name"/>
                <field name="room_type"/>
                <field name="floor"/>
                <field name="branch_id"/>
                <field name="capacity"/>
                <field name="status" widget="badge" decoration-success="status == 'available'" decoration-warning="status == 'occupied'" decoration-danger="status == 'maintenance'"/>
            </list>
        </field>
    </record>

    <record id="view_ag_room_form" model="ir.ui.view">
        <field name="name">ag.room.form</field>
        <field name="model">ag.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_type"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="floor"/>
                            <field name="capacity"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ag_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">ag.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
